[
 {
  "from": 8,
  "to": 39,
  "text": "Honestly, before Autumn"
 },
 {
  "from": 38,
  "to": 63,
  "text": "our sign-ups were"
 },
 {
  "from": 62,
  "to": 91,
  "text": "a black box."
 },
 {
  "from": 98,
  "to": 131,
  "text": "Someone would sign up"
 },
 {
  "from": 129,
  "to": 155,
  "text": "with their Gmail"
 },
 {
  "from": 154,
  "to": 184,
  "text": "and I'd be like, okay"
 },
 {
  "from": 182,
  "to": 210,
  "text": "who is this?"
 },
 {
  "from": 220,
  "to": 235,
  "text": "I would have"
 },
 {
  "from": 233,
  "to": 266,
  "text": "10 tabs open"
 },
 {
  "from": 265,
  "to": 301,
  "text": "LinkedIn, GitHub"
 },
 {
  "from": 309,
  "to": 326,
  "text": "their X"
 },
 {
  "from": 325,
  "to": 345,
  "text": "trying to just"
 },
 {
  "from": 343,
  "to": 379,
  "text": "piece things together."
 },
 {
  "from": 387,
  "to": 415,
  "text": "And most days"
 },
 {
  "from": 414,
  "to": 434,
  "text": "I wasn't able to"
 },
 {
  "from": 432,
  "to": 454,
  "text": "get to it."
 },
 {
  "from": 465,
  "to": 480,
  "text": "And now I don't"
 },
 {
  "from": 479,
  "to": 507,
  "text": "even think about it."
 },
 {
  "from": 506,
  "to": 538,
  "text": "Somebody signs up"
 },
 {
  "from": 537,
  "to": 564,
  "text": "and we get"
 },
 {
  "from": 563,
  "to": 601,
  "text": "notified in Slack."
 },
 {
  "from": 599,
  "to": 618,
  "text": "And by the time"
 },
 {
  "from": 617,
  "to": 642,
  "text": "I look at it"
 },
 {
  "from": 648,
  "to": 674,
  "text": "Autumn's already figured out"
 },
 {
  "from": 673,
  "to": 691,
  "text": "who they are and"
 },
 {
  "from": 690,
  "to": 723,
  "text": "what they're working on."
 },
 {
  "from": 730,
  "to": 758,
  "text": "There was this one sign-up"
 },
 {
  "from": 757,
  "to": 799,
  "text": "that looked totally random"
 },
 {
  "from": 798,
  "to": 839,
  "text": "just a personal email"
 },
 {
  "from": 840,
  "to": 861,
  "text": "and it turned out to"
 },
 {
  "from": 860,
  "to": 896,
  "text": "be the CTO of a"
 },
 {
  "from": 894,
  "to": 928,
  "text": "team that we'd been dying"
 },
 {
  "from": 927,
  "to": 951,
  "text": "to work with."
 },
 {
  "from": 964,
  "to": 992,
  "text": "We reached out the same"
 },
 {
  "from": 991,
  "to": 1018,
  "text": "day and got a Slack"
 },
 {
  "from": 1017,
  "to": 1053,
  "text": "channel set up with them."
 },
 {
  "from": 1062,
  "to": 1076,
  "text": "This is the part"
 },
 {
  "from": 1074,
  "to": 1102,
  "text": "that I love."
 },
 {
  "from": 1102,
  "to": 1130,
  "text": "It saves us time by"
 },
 {
  "from": 1128,
  "to": 1165,
  "text": "catching people that I would"
 },
 {
  "from": 1163,
  "to": 1200,
  "text": "have completely missed."
 }
]