[
 {
  "from": 8,
  "to": 39,
  "text": "Honestly, before Autumn"
 },
 {
  "from": 38,
  "to": 63,
  "text": "our sign-ups were"
 },
 {
  "from": 62,
  "to": 94,
  "text": "a black box."
 },
 {
  "from": 93,
  "to": 131,
  "text": "Somebody would sign up"
 },
 {
  "from": 130,
  "to": 151,
  "text": "with a Gmail"
 },
 {
  "from": 150,
  "to": 187,
  "text": "and I'd be like, okay"
 },
 {
  "from": 186,
  "to": 214,
  "text": "who is this?"
 },
 {
  "from": 223,
  "to": 238,
  "text": "I'd have like"
 },
 {
  "from": 237,
  "to": 271,
  "text": "10 tabs open"
 },
 {
  "from": 270,
  "to": 309,
  "text": "LinkedIn, GitHub"
 },
 {
  "from": 321,
  "to": 337,
  "text": "their X"
 },
 {
  "from": 336,
  "to": 372,
  "text": "trying to piece it together."
 },
 {
  "from": 379,
  "to": 408,
  "text": "And most days"
 },
 {
  "from": 406,
  "to": 426,
  "text": "I wasn't able to"
 },
 {
  "from": 425,
  "to": 447,
  "text": "get to it."
 },
 {
  "from": 458,
  "to": 473,
  "text": "And now I don't"
 },
 {
  "from": 472,
  "to": 500,
  "text": "even think about it."
 },
 {
  "from": 499,
  "to": 531,
  "text": "Somebody signs up"
 },
 {
  "from": 530,
  "to": 557,
  "text": "and we get"
 },
 {
  "from": 556,
  "to": 594,
  "text": "notified in Slack."
 },
 {
  "from": 592,
  "to": 611,
  "text": "And by the time"
 },
 {
  "from": 610,
  "to": 635,
  "text": "I look at it"
 },
 {
  "from": 641,
  "to": 667,
  "text": "Autumn's already figured out"
 },
 {
  "from": 666,
  "to": 684,
  "text": "who they are and"
 },
 {
  "from": 683,
  "to": 716,
  "text": "what they're working on."
 },
 {
  "from": 723,
  "to": 751,
  "text": "There was this one sign-up"
 },
 {
  "from": 750,
  "to": 792,
  "text": "that looked totally random"
 },
 {
  "from": 791,
  "to": 828,
  "text": "just a personal email"
 },
 {
  "from": 836,
  "to": 856,
  "text": "and it turned out to"
 },
 {
  "from": 854,
  "to": 881,
  "text": "be a CTO of a"
 },
 {
  "from": 880,
  "to": 922,
  "text": "team that we'd been dying"
 },
 {
  "from": 920,
  "to": 948,
  "text": "to work with."
 },
 {
  "from": 957,
  "to": 985,
  "text": "We reached out the same"
 },
 {
  "from": 984,
  "to": 1011,
  "text": "day and got a Slack"
 },
 {
  "from": 1010,
  "to": 1046,
  "text": "channel set up with them."
 },
 {
  "from": 1054,
  "to": 1068,
  "text": "This is the part"
 },
 {
  "from": 1067,
  "to": 1094,
  "text": "that I love."
 },
 {
  "from": 1095,
  "to": 1122,
  "text": "It saves us time by"
 },
 {
  "from": 1121,
  "to": 1156,
  "text": "catching people that I would"
 },
 {
  "from": 1155,
  "to": 1193,
  "text": "have completely missed."
 }
]